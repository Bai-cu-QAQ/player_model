{
  // 模型列表和 UI 中显示的名称。
  "displayName": "我的模型",
  // 贴图来源："model" 使用模型自带贴图，"skin" 使用玩家皮肤。
  "textureMode": "model",
  // 骨骼 pivot 来源："model" 使用 bbmodel 的 pivot，"vanilla" 使用原版玩家 pivot。
  "pivotMode": "model",
  // 是否把 anchors 分组的位移也应用到盔甲/手持物/披风等 feature。
  "customAnchors": false,
  // 旧版兼容字段；当前版本不会生成双层皮肤。
  "doubleLayer": true,
  "slim": false,
  // 可选 JPM 面部/眼睛覆盖模型路径；省略时自动查找同目录 player_face.jpm。
  // JPM 的 UV 以 textureSize 为准，通常使用玩家 64×64 皮肤。
  "face": "",
  // 贴图 UV 尺寸；0 表示从 bbmodel 自动读取。
  "textureWidth": 64,
  "textureHeight": 64,
  "anchors": {
    // "chest": { "x": 0, "y": 0, "z": 0, "scale": 0.6 }
  },
  "physics": {
    // 所有 _physics 骨骼的默认参数；单骨骼未写的字段会继承。
    "defaultSettings": {
      // "pendulum" 单骨骼摆动，"cloth" 连续布料链；省略时运行时使用 pendulum。
      "mode": "pendulum",
      // 以下为当前生效的自然摆动参数。非法/非有限值回退，超范围值会限幅。
      // 移动施力倍率，0..10。
      "motionStrength": 1.0,
      // 加速度施力倍率，0..10。
      "accelerationStrength": 0.12,
      // 回到静止姿态的响应速率，0.1..40 /秒。
      "restResponse": 8.0,
      // 摆动阻尼比，0.1..4；接近 1 时更平稳。
      "swingDamping": 0.9,
      // cloth 回正响应倍率，0.1..2。
      "clothResponseScale": 0.8,
      // 空气阻力，0..30 /秒。
      "airResistance": 1.5,
      // 最大角速度，1..1440 度/秒（不是弧度/秒）。
      "maxAngularSpeed": 360.0,
      // 施力平滑响应，0.1..60 /秒；越大响应越快。
      "forceSmoothing": 10.0,
      // 父骨骼旋转惯性倍率，0..2。
      "angularInertia": 0.7,
      // 竖直速度、竖直加速度受力倍率，0..10；0 仅关闭对应竖直分量。
      "verticalMotionScale": 1.0,
      "verticalAccelerationScale": 1.0,
      // 转头/视角的 yaw、pitch 惯性倍率，0..10；来自真实骨骼动画，不重复叠加镜头角度。
      "viewYawScale": 1.0,
      "viewPitchScale": 1.0,
      // 启动/停止旋转时的角加速度惯性增益，0..1；设 0 关闭。
      "angularAccelerationGain": 0.004,
      // 角加速度输入上限，0..300，单位 rad/s²。
      "maxAngularAcceleration": 40.0,
      "gravity": 0.8,
      // 旧版总旋转向量长度上限（度）；不设置 X/Y/Z 时保留球形限幅。
      "maxAngle": 70,
      // 可选模型空间旋转向量的每轴角度范围（度），不是骨骼局部欧拉角。
      // 每轴独立设置最小/最大值；省略一侧时回退到 maxAngle（cloth 包含 clothMaxAngleScale）。
      // 旧字段 maxAngleX/Y/Z 仍兼容，会解释为 [-maxAngleX, +maxAngleX]。
      // 范围受 maxAngleLimit 限制；min == max 锁定该轴。
      "angleXMin": null,
      "angleXMax": null,
      "angleYMin": null,
      "angleYMax": null,
      "angleZMin": null,
      "angleZMax": null,
      // 兼容旧配置的对称上限；新配置请优先使用上面的 angleXMin/Max。
      "maxAngleX": null,
      "maxAngleY": null,
      "maxAngleZ": null,
      "wind": 0.0,
      "substeps": 8,
      // 基础拖尾、加速度、动画和重力力矩增益。
      "motionGain": 0.065,
      "accelerationGain": 0.015,
      "animationGain": 0.045,
      "gravityGain": 0.04,
      // 角度和子步硬上限。
      "maxAngleLimit": 120,
      "maxSubsteps": 32,
      // 速度/加速度采样平滑和上限。
      "speedSmoothing": 10,
      "accelerationSmoothing": 8,
      "maxSpeed": 12.5,
      "maxAcceleration": 30,
      "maxAnimationSpeed": 6,
      // 以下兼容倍率仍生效；通常保留默认即可。
      "inertia": 1.0,
      "animationForce": 1.0,
      "speedGainScale": 1.0,
      "clothSpeedScale": 0.8,
      "clothMaxAngleScale": 1.25,
      // airDrag 仍作空气阻力兼容回退；优先设置 airResistance。
      "airDrag": 1.5,

      // 以下旧调参字段已过时，仅保留配置兼容；请优先使用上面的新参数。
      "stiffness": 75,
      "damping": 9,
      "drag": 0.0,
      "iterations": 3,
      "springBase": 6.0,
      "springDampingScale": 0.75,
      "springClothScale": 0.72,
      "dampingRatio": 0.82,
      "clothDampingRatio": 0.72,
      "liftScale": 1.25,
      "targetResponse": 4.0,
      "pitchOmegaScale": 0.6,
      "yawOmegaScale": 0.4,
      "rollOmegaScale": 0.6,
      "clothStiffnessScale": 0.65,
      "clothDampingScale": 0.9
    },
    // 只写需要覆盖的字段；不写 mode 不会把继承的 cloth 改成 pendulum。
    "bones": {
      "hair_physics": {
        "restResponse": 7.0,
        "swingDamping": 0.8,
        "angularInertia": 0.9,
        "airResistance": 1.5
      },
      "skirt_physics": {
        "mode": "cloth",
        "clothResponseScale": 0.7,
        "motionStrength": 0.8,
        "angularInertia": 0.8
      }
    }
  }
}
